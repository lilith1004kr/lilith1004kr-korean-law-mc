+import { describe, expect, it } from "vitest"
+import type { LawApiClient } from "../lib/api-client.js"
+import { searchInterpretations } from "./interpretations.js"
+
+interface Hit {
+  id: string
+  title: string
+  number: string
+}
+
+function expcXml(items: Hit[]): string {
+  return `<?xml version="1.0" encoding="UTF-8"?><Expc><totalCnt>${items.length}</totalCnt><page>1</page>` +
+    items.map(item =>
+      `<expc><법령해석례일련번호>${item.id}</법령해석례일련번호>` +
+      `<안건번호>${item.number}</안건번호><안건명><![CDATA[${item.title}]]></안건명>` +
+      `<회신일자>20240101</회신일자><회신기관명>법제처</회신기관명></expc>`
+    ).join("") + `</Expc>`
+}
+
+function clientFor(
+  responses: Record<string, Hit[]>,
+  calls: string[]
+): LawApiClient {
+  return {
+    fetchApi: async ({ extraParams }: { extraParams?: Record<string, string> }) => {
+      const query = extraParams?.query || ""
+      calls.push(query)
+      return expcXml(responses[query] || [])
+    },
+  } as unknown as LawApiClient
+}
+
+describe("searchInterpretations — AND 0건 자동 보정", () => {
+  it("개별 핵심어 결과를 병합·중복제거하고 원 질의 부합도가 높은 항목을 먼저 둔다", async () => {
+    const calls: string[] = []
+    const relevant = {
+      id: "429214",
+      number: "21-0638",
+      title: "생활소음에 사람의 목소리가 포함되는지 여부",
+    }
+    const r = await searchInterpretations(clientFor({
+      "생활소음 목소리": [],
+      "생활소음": [
+        { id: "111", number: "13-0132", title: "생활소음 규제기준에 관한 질의" },
+        relevant,
+      ],
+      "목소리": [relevant],
+    }, calls), {
+      query: "생활소음 목소리",
+      display: 20,
+      page: 1,
+    })
+
+    const text = r.content[0].text
+    expect(calls).toEqual(["생활소음 목소리", "생활소음", "목소리"])
+    expect(text).toContain("검색 보정")
+    expect(text.indexOf("21-0638")).toBeLessThan(text.indexOf("13-0132"))
+    expect((text.match(/21-0638/g) || [])).toHaveLength(1)
+  })
+
+  it("단일 검색어는 추가 호출하지 않는다", async () => {
+    const calls: string[] = []
+    const r = await searchInterpretations(clientFor({ "생활소음": [] }, calls), {
+      query: "생활소음",
+      display: 20,
+      page: 1,
+    })
+
+    expect(calls).toEqual(["생활소음"])
+    expect(r.content[0].text).toContain("[NOT_FOUND]")
+  })
+
+  it("상류가 검색어를 무시한 무관 목록은 보정 결과로 채택하지 않는다", async () => {
+    const calls: string[] = []
+    const junk = [{ id: "999", number: "99-9999", title: "자동차 등록 절차" }]
+    const r = await searchInterpretations(clientFor({
+      "생활소음 목소리": [],
+      "생활소음": junk,
+      "목소리": junk,
+    }, calls), {
+      query: "생활소음 목소리",
+      display: 20,
+      page: 1,
+    })
+
+    expect(r.content[0].text).toContain("[NOT_FOUND]")
+    expect(r.content[0].text).not.toContain("자동차 등록 절차")
+  })
+})
