+++ b/src/tools/interpretation-search-fallback.ts
@@ -0,0 +1,92 @@
+import type { LawApiClient } from "../lib/api-client.js"
+import {
+  buildDecisionFallbackQueries,
+  decisionTextMatchesQuery,
+  rankDecisionItems,
+} from "../lib/decision-query.js"
+import { parseInterpretationXML } from "../lib/xml-parser.js"
+
+type Interpretation = ReturnType<typeof parseInterpretationXML>["items"][number]
+
+interface InterpretationSearchArgs {
+  query: string
+  display?: number
+  page?: number
+  sort?: string
+  apiKey?: string
+}
+
+export interface InterpretationSearchResult {
+  currentPage: number
+  upstreamTotal: number
+  items: Interpretation[]
+  fallbackQueries: string[]
+}
+
+function searchableText(item: Interpretation): string {
+  return [
+    item.안건명,
+    item.질의요지,
+    item.회답,
+    item.법령해석례번호,
+    item.소관부처명,
+  ].filter(Boolean).join(" ")
+}
+
+function itemKey(item: Interpretation): string {
+  return item.법령해석례일련번호 || item.법령해석례번호 || item.안건명
+}
+
+export async function searchInterpretationsWithFallback(
+  apiClient: LawApiClient,
+  args: InterpretationSearchArgs
+): Promise<InterpretationSearchResult> {
+  // unified search의 query는 모든 도메인을 위해 optional이다. interpretation 직접
+  // 스키마에서는 필수지만 런타임 경계를 방어해 무질의 목록 조회도 깨뜨리지 않는다.
+  const originalQuery = typeof args.query === "string" ? args.query : ""
+  const fetchQuery = async (query: string) => {
+    const extraParams: Record<string, string> = {
+      query,
+      display: String(args.display || 20),
+      page: String(args.page || 1),
+    }
+    if (args.sort) extraParams.sort = args.sort
+    const xmlText = await apiClient.fetchApi({
+      endpoint: "lawSearch.do",
+      target: "expc",
+      extraParams,
+      apiKey: args.apiKey,
+    })
+    return parseInterpretationXML(xmlText)
+  }
+
+  const primary = await fetchQuery(originalQuery)
+  let items = primary.items
+  const fallbackQueries: string[] = []
+
+  // 공백 키워드는 AND 검색이다. 원 질의가 0건인 첫 페이지만 개별 핵심어를
+  // 제한적으로 재조회하고, 로컬 관련성 가드 후 병합한다.
+  if (originalQuery && primary.totalCnt === 0 && (args.page || 1) === 1) {
+    const merged = new Map<string, Interpretation>()
+    for (const query of buildDecisionFallbackQueries(originalQuery)) {
+      const fallback = await fetchQuery(query)
+      const related = fallback.items.filter(item =>
+        decisionTextMatchesQuery(searchableText(item), query)
+      )
+      if (related.length === 0) continue
+      fallbackQueries.push(query)
+      for (const item of related) merged.set(itemKey(item), item)
+    }
+    if (merged.size > 0) {
+      items = rankDecisionItems(Array.from(merged.values()), originalQuery, searchableText)
+        .slice(0, args.display || 20)
+    }
+  }
+
+  return {
+    currentPage: primary.page,
+    upstreamTotal: primary.totalCnt,
+    items,
+    fallbackQueries,
+  }
+}
