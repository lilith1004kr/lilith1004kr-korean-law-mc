diff --git a/src/lib/decision-query.ts b/src/lib/decision-query.ts
new file mode 100644
index 0000000..5229a11
--- /dev/null
+++ b/src/lib/decision-query.ts
@@ -0,0 +1,91 @@
+/**
+ * 결정례 검색어 보정 공용 유틸.
+ * 법제처 결정례 검색은 공백 구분 검색어를 AND로 처리한다. 원 질의가 0건일 때만
+ * 핵심어를 개별 조회하고, 상류가 검색어를 무시한 결과는 로컬에서 다시 거른다.
+ */
+
+const GENERIC_QUERY_WORDS = new Set([
+  "관련", "관한", "대한", "여부", "해석", "해석례", "법령해석", "법령해석례",
+  "판례", "결정", "결정례", "사례", "검토", "검색", "조회", "질의", "문의",
+  "찾아줘", "찾아주세요", "알려줘", "알려주세요",
+])
+
+const PARTICLE_SUFFIXES = [
+  "으로부터", "에서부터", "에게서", "으로써", "으로서", "에서는", "에게는",
+  "까지", "부터", "에서", "에게", "으로", "로서", "로써", "에는", "와의", "과의",
+  "은", "는", "이", "가", "을", "를", "의", "에", "와", "과", "도",
+]
+
+function stripParticle(word: string): string {
+  for (const suffix of PARTICLE_SUFFIXES) {
+    if (!word.endsWith(suffix)) continue
+    const stem = word.slice(0, -suffix.length)
+    if (stem.length >= 2) return stem
+  }
+  return word
+}
+
+function normalizeQuery(query: string): string {
+  return query
+    .normalize("NFC")
+    .replace(/[“”‘’「」『』()[\]{}<>]/gu, " ")
+    .replace(/[^\p{L}\p{N}\s·ㆍ‧•・-]+/gu, " ")
+    .replace(/\s+/gu, " ")
+    .trim()
+}
+
+export function decisionQueryTerms(query: string): string[] {
+  const out: string[] = []
+  const seen = new Set<string>()
+  for (const raw of normalizeQuery(query).split(" ")) {
+    const word = stripParticle(raw.trim())
+    if (word.length < 2 || GENERIC_QUERY_WORDS.has(word) || seen.has(word)) continue
+    seen.add(word)
+    out.push(word)
+  }
+  return out
+}
+
+/** 원 질의는 호출자가 이미 시도했으므로 개별 핵심어만 반환한다. */
+export function buildDecisionFallbackQueries(query: string, max = 3): string[] {
+  const terms = decisionQueryTerms(query)
+  return terms.length >= 2 ? terms.slice(0, max) : []
+}
+
+function compact(value: string): string {
+  return value
+    .normalize("NFC")
+    .toLowerCase()
+    .replace(/[^\p{L}\p{N}]+/gu, "")
+}
+
+/** 상류가 query를 무시해 돌려준 무관 목록을 보정 결과로 채택하지 않는 가드. */
+export function decisionTextMatchesQuery(text: string, query: string): boolean {
+  const haystack = compact(text)
+  const terms = decisionQueryTerms(query)
+  return terms.length > 0 && terms.every(term => haystack.includes(compact(term)))
+}
+
+export function decisionRelevanceScore(text: string, originalQuery: string): number {
+  const haystack = compact(text)
+  const terms = decisionQueryTerms(originalQuery)
+  let score = 0
+  for (const term of terms) {
+    if (haystack.includes(compact(term))) score += 100 + Math.min(term.length, 20)
+  }
+  const full = compact(originalQuery)
+  if (full && haystack.includes(full)) score += 500
+  return score
+}
+
+/** 관련도 내림차순, 동점은 상류 순서 유지. */
+export function rankDecisionItems<T>(
+  items: T[],
+  originalQuery: string,
+  toText: (item: T) => string
+): T[] {
+  return items
+    .map((item, index) => ({ item, index, score: decisionRelevanceScore(toText(item), originalQuery) }))
+    .sort((a, b) => b.score - a.score || a.index - b.index)
+    .map(row => row.item)
+}
